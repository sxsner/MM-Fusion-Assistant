{
  "name": "mm-fusion-assistant",
  "version": "1.0.0",
  "description": "Chrome Extension - 多模型聚合助手",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=logged-in --headed",
    "test:e2e:fresh": "playwright test --project=fresh --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "setup-profile": "node tests/scripts/setup-profile.mjs",
    "logs": "node tests/scripts/collect-logs.mjs",
    "debug": "npm run test:e2e && npm run logs",
    "verify": "npm run build && npm run test:unit && npm run test:e2e",
    "clean": "rm -rf dist test-results test-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.0.260",
    "@types/dompurify": "^3.0.0",
    "@types/marked": "^5.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "jsdom": "^29.1.1",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "dompurify": "^3.0.0",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
